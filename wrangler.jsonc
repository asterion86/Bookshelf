{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookshelf",
  "main": "src/server.js",
  "compatibility_date": "2026-10-01",

  // Files in public/ are served directly; everything else goes to the app.
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookshelf",
      // Replace with the id `wrangler d1 create bookshelf` prints.
      "database_id": "e660f46a-2898-4ec7-9073-e802e9d1e0d3",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "SITE_NAME": "Bookshelf"
  }
  // INVITE_CODE is a secret: `wrangler secret put INVITE_CODE`.
  // For local development put it in .dev.vars instead.
}
