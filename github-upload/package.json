{
  "name": "bookshelf",
  "version": "0.2.0",
  "description": "A small communal book-lending tracker",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply bookshelf --local",
    "db:migrate:remote": "wrangler d1 migrations apply bookshelf --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
